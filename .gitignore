# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Instance-specific database and secret files
# The trailing * also covers the SQLite sidecar files (-wal, -shm).
instance/*.db*
instance/*.sqlite*
instance/*.key
instance/vmrecovery.db*
instance/*.env
instance/backups/
instance/db-backups/
instance/*.log

# Local configuration. Copy .env.example and .env.local.example to these.
.env
.env.local
.env.*.local

# Local export files
*.csv
!docs/*.csv

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*~

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
