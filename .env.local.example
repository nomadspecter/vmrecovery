# ---------------------------------------------------------------------------
# Local developer overrides
#
# Copy this file to `.env.local`:
#
#     cp .env.local.example .env.local
#
# `.env.local` is read AFTER `.env` and `instance/vmrecovery.env`, so it wins
# over both. It is never committed.
#
# It is SKIPPED entirely in production. The systemd unit sets
# VMR_ENV=production, and the application then ignores this file, so a
# developer's simulator settings can never take the real service off the real
# data.
#
# Typical uses:
#   * point the database somewhere else while testing
#   * run the simulated VirtualBox instead of the real one
#   * shorten the check interval so you can see recovery happen quickly
#   * use a different port so a second instance can run beside the first
#
# The example below is the simulator stack: no VirtualBox needed, and a
# throwaway database so experiments never touch the lab data.
#
# On a machine that hosts the real lab, prefer to keep this file pointing at
# the same data as the service, and only change the developer conveniences
# (the development server, the log level, a faster check interval). Otherwise
# a hand-started instance quietly behaves differently from the service.
# ---------------------------------------------------------------------------

# Run against the built-in simulator, so no VirtualBox is needed.
VMR_SIMULATE=1

# React quickly while developing.
VMR_CHECK_SECONDS=5
VMR_LOG_LEVEL=DEBUG

# A separate database, so experiments never touch the lab data.
VMR_DB=instance/vmrecovery-dev.db
VMR_BACKUP_DIR=instance/backups-dev
VMR_DB_BACKUP_DIR=instance/db-backups-dev

# A different port, so a development server can run beside the service.
VMR_PORT=5001

# Use Flask's development server for the hand-started instance. It is rarely
# worth it: the reloader only runs with the debugger on, and waitress is the
# more robust of the two.
VMR_DEV_SERVER=0

# There is no TLS on a development machine, so the cookie is not HTTPS-only.
VMR_COOKIE_SECURE=0

# A separate session key and API token for the development instance, so the
# two stacks cannot be confused. Generate them with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VMR_SECRET=
VMR_API_TOKEN=
