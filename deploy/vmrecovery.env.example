# Machine-specific overrides for this host.
#
# Copy this file to instance/vmrecovery.env:
#
#     cp deploy/vmrecovery.env.example instance/vmrecovery.env
#
# The systemd unit reads it as an EnvironmentFile after the shared .env, so
# the values here win over .env. The application reads the same file, so it
# applies whether the service is started by systemd or by hand.
#
# Everything here is optional: the shared .env already holds production-safe
# defaults. Uncomment only what this host needs to change.
#
# Credentials (the session key, the API token, the SMTP password, the webhook
# secret) live in .env. Copy them here only if this host needs different ones.

# --- Paths -----------------------------------------------------------------
# Absolute, so the service finds its data no matter where it is started from.
#VMR_DB=/home/nomad/vmrecovery/instance/vmrecovery.db
#VMR_BACKUP_DIR=/home/nomad/vmrecovery/instance/backups
#VMR_DB_BACKUP_DIR=/home/nomad/vmrecovery/instance/db-backups

# --- Web server ------------------------------------------------------------
# Bind address. Keep 127.0.0.1 and put a reverse proxy in front if the
# dashboard must be reachable from the lab network.
#VMR_HOST=127.0.0.1
#VMR_PORT=5000

# Set to 1 only when the site is served over HTTPS (makes the cookie HTTPS-only).
#VMR_COOKIE_SECURE=0

# How long a login lasts, in hours, and the login lockout.
#VMR_SESSION_HOURS=12
#VMR_LOGIN_MAX_FAILURES=5
#VMR_LOGIN_WINDOW_SECONDS=300

# --- Background recovery service -------------------------------------------
#VMR_CHECK_SECONDS=30
#VMR_FAIL_THRESHOLD=2
#VMR_MAX_RESTORES_PER_HOUR=3
#VMR_HEARTBEAT_TIMEOUT=90
#VMR_VBOX_TIMEOUT=1800
#VMR_VBOX_QUERY_TIMEOUT=60
#VMR_VBOX_ACTION_TIMEOUT=180
#VMR_VBOX_RESTORE_TIMEOUT=600
#VMR_VBOX_LOCK_TIMEOUT=30
#VMR_WORKER=1

# --- VirtualBox ------------------------------------------------------------
# Absolute path: systemd gives the service a minimal PATH.
#VMR_VBOXMANAGE=/usr/bin/VBoxManage
#VMR_SIMULATE=0
# Live snapshots need a guest that supports them; with a guest that does not,
# the command never returns.
#VMR_LIVE_SNAPSHOTS=0
# Seconds a machine may stay in a transitional VirtualBox state before it
# counts as stuck.
#VMR_BUSY_TIMEOUT=300

# --- Storage and retention -------------------------------------------------
#VMR_BACKUP_RETENTION=3
#VMR_DB_BACKUP_KEEP=10
#VMR_DISK_MIN_FREE_GB=5.0
#VMR_DISK_MIN_FREE_PCT=10.0
#VMR_EVENT_RETENTION_DAYS=90

# --- Logging ---------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR.
#VMR_LOG_LEVEL=INFO
