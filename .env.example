# ---------------------------------------------------------------------------
# VM Recovery System - configuration
#
# Copy this file to `.env` and edit it:
#
#     cp .env.example .env
#
# `.env` is read by the application at start-up. Values here are the
# production defaults for a single lab host. Anything set as a real
# environment variable (systemd, Docker, your shell) wins over this file.
#
# The full order of precedence, highest first:
#
#   1. runtime overrides from the Settings page (stored in the database)
#   2. real environment variables
#   3. .env.local                    (developer layer, skipped in production)
#   4. instance/vmrecovery.env       (machine layer, read by the systemd unit)
#   5. .env                          (this file)
#   6. the built-in defaults
#
# Runtime overrides made from the Settings page are stored in the database and
# win over every file. Use "Reset" there to fall back to the value here.
#
# A note on VMR_ENV: it is only read as a REAL environment variable, never
# from a file. The systemd unit sets VMR_ENV=production, which is what makes
# the application skip `.env.local`. To run the production instance by hand:
#
#     VMR_ENV=production .venv/bin/python run.py
#
# Never commit `.env` or `.env.local`: they can contain passwords.
# ---------------------------------------------------------------------------

# --- Web server ------------------------------------------------------------
# Bind address. Keep 127.0.0.1 and put a reverse proxy in front if the
# dashboard must be reachable from the lab network.
VMR_HOST=127.0.0.1
VMR_PORT=5000

# Set to 1 only when the site is served over HTTPS (makes the cookie HTTPS-only).
VMR_COOKIE_SECURE=0

# Use Flask's development server instead of waitress. Never enable in production.
VMR_DEV_SERVER=0

# How long a login lasts, in hours.
VMR_SESSION_HOURS=12

# Failed logins from one IP address before the lockout starts, and how long
# that lockout lasts in seconds.
VMR_LOGIN_MAX_FAILURES=5
VMR_LOGIN_WINDOW_SECONDS=300

# --- Background recovery service -------------------------------------------
# How often every virtual machine is checked.
VMR_CHECK_SECONDS=30

# Bad checks in a row before a machine counts as failed. Two avoids false
# alarms from a single unlucky reading.
VMR_FAIL_THRESHOLD=2

# Automatic restores per machine per hour before the system stops and alerts
# an administrator. This is what stops an endless restore loop.
VMR_MAX_RESTORES_PER_HOUR=3

# Seconds without a guest heartbeat before a running machine counts as frozen.
# Only used for machines that have a heartbeat property set.
VMR_HEARTBEAT_TIMEOUT=90

# Seconds before a VBoxManage command is killed. Exports of large machines
# are slow, so this is generous on purpose.
VMR_VBOX_TIMEOUT=1800

# Seconds before a read-only VBoxManage query (state, uuid, snapshot list) is
# killed. These queries are quick, so a minute is generous.
VMR_VBOX_QUERY_TIMEOUT=60

# Seconds before a short VBoxManage command is killed: power off, suspend,
# discard state, start, pause, resume, rename. These commands are quick, so
# three minutes is generous. They used to wait for the long timeout above, so
# one hung command held the VirtualBox lock for half an hour.
VMR_VBOX_ACTION_TIMEOUT=180

# Seconds before a snapshot restore is killed. VirtualBox merges the
# differencing disks while it restores, so this takes minutes.
VMR_VBOX_RESTORE_TIMEOUT=600

# Seconds a web action waits for the global VirtualBox lock before it gives up
# with a friendly message, and how long the monitoring worker waits before it
# skips a machine.
VMR_VBOX_LOCK_TIMEOUT=30

# Set to 0 to serve the web interface without the background recovery loop.
VMR_WORKER=1

# --- VirtualBox ------------------------------------------------------------
# Path to VBoxManage. Use the absolute path: systemd gives the service a
# minimal PATH, so a bare command name can fail to resolve.
#   VBoxManage --version
VMR_VBOXMANAGE=/usr/bin/VBoxManage

# Set to 1 to use the built-in simulator instead of real VirtualBox. Useful
# for demonstrations and for trying the system out on a machine that has no
# VirtualBox installed.
VMR_SIMULATE=0

# Set to 1 to snapshot a running machine with "--live". This needs a guest
# that supports live snapshots: with a guest that does not, the command never
# returns and the whole system waits with it. Leave it off unless the guest
# is known to support them.
VMR_LIVE_SNAPSHOTS=0

# Seconds a machine may stay in a transitional VirtualBox state
# (onlinesnapshotting, probing, saving) before it is reported as
# "needs_admin" and an alert is raised.
VMR_BUSY_TIMEOUT=300

# --- Storage ---------------------------------------------------------------
# Where independent .ova appliance exports are written. Use an absolute path
# in production so the service finds it from any working directory.
VMR_BACKUP_DIR=instance/backups

# How many independent appliance backups are kept per machine.
VMR_BACKUP_RETENTION=3

# Where rotating backups of the application database are written.
VMR_DB_BACKUP_DIR=instance/db-backups

# How many application database backups to keep.
VMR_DB_BACKUP_KEEP=10

# Minimum free host storage before a low-disk warning is raised. The warning
# is raised when either limit is breached.
VMR_DISK_MIN_FREE_GB=5.0
VMR_DISK_MIN_FREE_PCT=10.0

# --- Data retention --------------------------------------------------------
# Days of event history to keep. 0 keeps every event forever.
VMR_EVENT_RETENTION_DAYS=90

# --- Email notifications ---------------------------------------------------
# Set VMR_NOTIFY_EMAIL=1 to send crash alerts, failed restores, restore
# requests and new machine requests by email.
VMR_NOTIFY_EMAIL=0
VMR_SMTP_HOST=localhost
VMR_SMTP_PORT=587
VMR_SMTP_USER=
VMR_SMTP_PASSWORD=
VMR_SMTP_FROM=vmrecovery@localhost
VMR_SMTP_TO=
VMR_SMTP_TLS=1

# --- Webhook notifications -------------------------------------------------
# Set VMR_NOTIFY_WEBHOOK=1 to POST the same notifications to a JSON endpoint
# (a chat webhook, a ticketing system, and so on).
VMR_NOTIFY_WEBHOOK=0
VMR_WEBHOOK_URL=
# When set, the request body is signed with HMAC-SHA256 and sent in the
# X-VMRecovery-Signature header as "sha256=<hex digest>".
VMR_WEBHOOK_SECRET=

# --- API -------------------------------------------------------------------
# Bearer token for the read-only JSON API under /api. Leave empty to keep the
# API switched off. A token can also be generated from the Settings page.
#
#     curl -H "Authorization: Bearer <token>" http://127.0.0.1:5000/api/vms
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VMR_API_TOKEN=

# --- Storage locations -----------------------------------------------------
# The application database. It is created on first start.
VMR_DB=instance/vmrecovery.db

# The Flask session signing key. When this is empty a random key is generated
# once and kept in instance/secret.key. Set it explicitly to share a key
# between several processes or to survive a rebuild of the instance directory.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
VMR_SECRET=

# --- Logging ---------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR.
VMR_LOG_LEVEL=INFO
